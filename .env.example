# ── docker compose (production) ─────────────────────────────────────────
# Shared secret between the API and the worker. Generate with:
#   openssl rand -hex 32
WORKER_TOKEN=""
# Address the web container is published on (put a TLS proxy in front).
# PUBLISH=127.0.0.1:8080
# gVisor for kernel-level isolation of the worker (install runsc first).
# WORKER_RUNTIME=runsc
# WORKER_MEMORY=2g
# WORKER_CPUS=2
# WORKER_PIDS=256

# ── sign-in (API server; server/auth.ts) ────────────────────────────────
# Running programs needs a signed-in user; everything else is open.
# REQUIRE_SIGNIN_TO_RUN=1            0 lets anyone run programs
# Key for session cookies and sign-in links (required in production):
#   openssl rand -hex 32             changing it signs everyone out
AUTH_SECRET=""
# The address users open (scheme://host[:port], no path). Required in
# production; Google's redirect URI and the emailed links are built from it.
# PUBLIC_URL="https://biton.example.com"
# SESSION_DAYS=30
#
# Google: create an OAuth client ID ("Web application") in the Google Cloud
# console, with the authorised redirect URI  $PUBLIC_URL/api/auth/google/callback
# (for development: http://localhost:5180/api/auth/google/callback with npm run dev:all).
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
#
# Email magic links: any SMTP server or provider (SES, Resend, Postmark,
# Mailgun, Gmail...). Without SMTP_URL, development prints the links to the
# server log, and production offers no email sign-in.
# SMTP_URL="smtps://user:password@smtp.example.com:465"   (or smtp://...:587 with STARTTLS)
# EMAIL_FROM="Biton Web Compiler <no-reply@biton.example.com>"
# SIGNIN_EMAILS_PER_IP_PER_HOUR=10
# SIGNIN_EMAILS_PER_ADDRESS_PER_HOUR=5

# ── frontend (read by Vite at build time) ───────────────────────────────
# Leave unset to call the API on the same origin.
# VITE_API_BASE_URL="https://compiler-api.example.com"
# Where `npm run dev` forwards /api (default http://127.0.0.1:8080).
# BITON_API_TARGET="http://127.0.0.1:8080"

# ── API server (server/index.ts) ────────────────────────────────────────
# PORT=8080
# HOST=127.0.0.1
# Forward jobs to a worker. Unset = run jobs in-process (development only;
# refused when NODE_ENV=production).
# WORKER_URL="http://worker:9000"
# CORS_ORIGIN="https://biton.example.com"   (sign-in needs the frontend on the API's own origin)
# Result cache for type checks and --emit output (0 disables).
# CACHE_MB=64

# ── AI completion (optional; server-side provider proxy) ─────────────────
# Works with any OpenAI-compatible endpoint. The key stays on the server:
# never put it in a VITE_* variable, which Vite exposes to the browser.
# AI_ENABLED=1
#
# Gemini (free tier): https://aistudio.google.com/apikey
# AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# AI_MODEL="gemini-2.5-flash"
# AI_API_KEY=""
#
# Groq (free tier, low latency):
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="llama-3.3-70b-versatile"
# AI_API_KEY=""
#
# OpenRouter (some :free models):
# AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_MODEL="qwen/qwen-2.5-coder-32b-instruct:free"
# AI_API_KEY=""
#
# Ollama (local, no provider key):
# AI_BASE_URL="http://127.0.0.1:11434/v1"
# AI_MODEL="qwen2.5-coder:7b"
# AI_API_KEY="ollama"
#
# AI_MAX_TOKENS=256               output cap per suggestion
# AI_MAX_BEFORE=4000              characters sent before the cursor
# AI_MAX_AFTER=2000               characters sent after the cursor
# AI_TIMEOUT_MS=10000
# AI_REQUIRE_SIGNIN=1             default: on in production when runs need sign-in
#                                 (0 allows anonymous, rate-limited use)

# ── rate limiting (per client IP; IPv6 per /64) ──
# RATE_LIMIT=on                    "off" disables it
# Reverse proxies in front of the API whose X-Forwarded-For is trusted.
# 0 = use the socket address. Behind one TLS proxy set 1; behind a CDN and
# a load balancer, 2. Too low: all users share one limit. Too high: users
# can spoof their address.
# TRUST_PROXY=0
# RATE_RUN_PER_MIN=20              program runs per minute ...
# RATE_RUN_BURST=10                ... with this many allowed back to back
# RATE_CHECK_PER_MIN=120           type checks + --emit (cache hits are free)
# RATE_CHECK_BURST=40
# RATE_AI_PER_MIN=30               AI completions per minute
# RATE_AI_BURST=10
# RATE_MAX_INFLIGHT=3              concurrent jobs per client
# RATE_MAX_CLIENTS=100000          tracked clients (memory bound)

# ── worker / job execution (server/worker.ts, or the API in development) ─
# Compiler binary, and the directory holding its standard library
# (stdlib/*.bit). Unset: the compiler finds its own (installed or source tree).
BITON_BIN="biton"
# BITON_HOME="/opt/biton/share/biton"
# BITON_INCLUDE=""                 extra -I paths, ':'-separated
# uid:  each job runs as its own unprivileged user (worker container; default
#       when NODE_ENV=production). none: as this user (development default).
# BITON_SANDBOX=none
# ALLOW_UNSANDBOXED=1              permit BITON_SANDBOX=none in production
# ALLOW_EGRESS=1                   permit a worker that can reach the internet
# EGRESS_PROBE=1.1.1.1:443         must be unreachable from the worker
# JOB_UID_BASE=20000               slot i runs as uid JOB_UID_BASE+i
# JOB_ROOT=/jobs
# WORKER_HOST=127.0.0.1
# WORKER_PORT=9000
# MAX_CONCURRENT=2                 parallel jobs (= job uids)
# MAX_QUEUE=32                     waiting jobs before HTTP 503
# RUN_TIMEOUT_MS=5000
# COMPILE_TIMEOUT_MS=30000
# RUN_MEMORY_MB=256                address-space limit for programs
# COMPILE_MEMORY_MB=1536           address-space limit for the compiler
# JOB_MAX_PROCS=32                 processes+threads per job (uid mode)
# MAX_OUTPUT_BYTES=262144
# MAX_SOURCE_BYTES=131072
# MAX_STDIN_BYTES=65536
# MAX_PROJECT_BYTES=524288         all files of a multi-file project together
