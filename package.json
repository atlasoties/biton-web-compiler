{
  "name": "biton-web-compiler",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev:all": "node scripts/dev.mjs",
    "dev": "vite",
    "server": "node server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --test server/*.test.ts src/lib/*.test.ts src/editor/*.test.ts test/*.test.ts",
    "test:unit": "node --test server/*.test.ts src/lib/*.test.ts src/editor/*.test.ts",
    "test:examples": "node --test test/examples.test.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
