// Errors are values: a function that can fail returns `T!` (its value,
// Ok, or an error, Err), and `T?` marks a value that may be absent.
// There are no exceptions. `try` gives the Ok value or returns the
// failure from the current function.
import std.strings.{parse_int}

fn digit(c: char) int! {
    if c < '0' or c > '9' {
        return error(message: "not a digit", code: c as int)
    }
    return (c - '0') as int
}

fn two_digits(a: char, b: char) int! {
    return try digit(a) * 10 + try digit(b)
}

fn find(xs: []int, want: int) int? {
    for i, x in xs {
        if x == want { return Some(i) }
    }
    return null
}

fn safe_div(a: int, b: int) int! {
    if b == 0 { return error(message: "division by zero") }
    return a / b
}

fn report(r: int!) {
    when r {
        Ok(n) -> print("  ok: {n}")
        Err(e) -> print("  error: {e.message} (code {e.code})")
    }
}

fn main() int {
    print("two_digits('4', '2'):")
    report(two_digits('4', '2'))
    print("two_digits('4', 'x'):")
    report(two_digits('4', 'x'))
    print("safe_div(7, 0):")
    report(safe_div(7, 0))

    xs := [4, 8, 15, 16, 23, 42]
    when find(xs, 15) {
        Some(i) -> print("15 is at index {i}")
        null -> print("15 is missing")
    }
    print("99 found: {find(xs, 99).is_some()}")

    // `??` gives the value, or a default; some_or does the same
    print("parse_int(\"-17\") = {parse_int("-17") ?? 0}")
    print("parse_int(\"abc\") = {some_or(parse_int("abc"), 0)}")
    print("safe_div(9, 3) or -1 = {ok_or(safe_div(9, 3), -1)}")
    return 0
}
